<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <stack-layout id="root">
            <children>
                <flow-layout direction="horizontal" id="window">
                    <children>
                        <flow-layout direction="vertical" id="window-left">
                            <children>
                                <button id="category-General Settings">
                                    <sizing>
                                        <horizontal method="fixed">50</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>General</text>
                                </button>

                                <button id="category-Flooding Canyon (Void Holes) Room">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Holes</text>
                                </button>

                                <button id="category-Sunken Grotto (Hold) Room">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Hold</text>
                                </button>

                                <button id="category-Nameless Cave (Light) Room">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Light</text>
                                </button>

                                <button id="category-Weeping Soulroot (Tree) Room">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Tree</text>
                                </button>

                                <button id="category-Blueshift Wilds (Bulb) Room">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Bulb</text>
                                </button>

                                <button id="category-Twisted Jungle (Gather) Room">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Gather</text>
                                </button>

                                <button id="category-Gregory Bossfight">
                                    <sizing>
                                        <horizontal method="fixed">50</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Gregory</text>
                                </button>
                            </children>
                            <vertical-alignment>center</vertical-alignment>
                            <horizontal-alignment>center</horizontal-alignment>
                            <sizing>
                                <horizontal method="fixed">62</horizontal>
                                <vertical method="fixed">195</vertical>
                            </sizing>
                            <padding>
                                <left>4</left>
                            </padding>
                            <gap>6</gap>
                        </flow-layout>

                        <flow-layout direction="horizontal" id="separator">
                            <children/>
                            <sizing>
                                <horizontal method="fixed">6</horizontal>
                                <vertical method="fixed">195</vertical>
                            </sizing>
                        </flow-layout>

                        <stack-layout id="right-window">
                            <children>
                                <flow-layout direction="vertical" id="bg-holder">
                                    <children>
                                        <flow-layout direction="horizontal" id="top-bar">
                                            <children>
                                                <label id="top-bar-label">
                                                    <sizing>
                                                        <vertical method="fixed">15</vertical>
                                                        <horizontal method="content">0</horizontal>
                                                    </sizing>
                                                    <!--horizontal-text-alignment>center</horizontal-text-alignment-->
                                                    <vertical-text-alignment>center</vertical-text-alignment>
                                                </label>
                                            </children>
                                            <sizing>
                                                <vertical method="fixed">15</vertical>
                                                <horizontal method="fixed">254</horizontal>
                                            </sizing>
                                            <horizontal-alignment>center</horizontal-alignment>
                                            <vertical-alignment>center</vertical-alignment>
                                        </flow-layout>

                                        <scroll direction="vertical">
                                            <flow-layout direction="vertical" id="entry-holder">
                                                <children/>
                                                <sizing>
                                                    <horizontal method="fixed">248</horizontal>
                                                    <vertical method="content">0</vertical>
                                                </sizing>
                                                <gap>4</gap>
                                                <padding>
                                                    <vertical>4</vertical>
                                                </padding>
                                            </flow-layout>
                                            <sizing>
                                                <horizontal method="fixed">248</horizontal>
                                                <vertical method="fixed">168</vertical>
                                            </sizing>
                                            <scrollbar-thiccness>0</scrollbar-thiccness>
                                        </scroll>
                                    </children>
                                    <sizing>
                                        <horizontal method="fixed">262</horizontal>
                                        <vertical method="fixed">187</vertical>
                                    </sizing>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <vertical-alignment>top</vertical-alignment>
                                    <padding>
                                        <top>4</top>
                                    </padding>
                                </flow-layout>
                            </children>
                            <sizing>
                                <horizontal method="fixed">266</horizontal>
                                <vertical method="fixed">195</vertical>
                            </sizing>
                            <padding>
                                <right>4</right>
                                <vertical>4</vertical>
                            </padding>
                        </stack-layout>
                    </children>

                    <sizing>
                        <!-- roughly 2x and 1.1x the sizes of the survival inventory -->
                        <horizontal method="fixed">334</horizontal>
                        <vertical method="fixed">195</vertical>
                    </sizing>
                    <allow-overflow>true</allow-overflow>
                </flow-layout>
            </children>

            <horizontal-alignment>center</horizontal-alignment>
            <vertical-alignment>center</vertical-alignment>
        </stack-layout>
    </components>
    
    <templates>
        <template name="entry-bool">
            <flow-layout direction="horizontal">
                <children>
                    <flow-layout direction="vertical">
                        <children>
                            <label>
                                <text>{{title}}</text>
                                <color>#e66aff</color>
                                <margins>
                                    <top>1</top>
                                    <left>4</left>
                                </margins>
                            </label>
                            <label>
                                <text>{{desc}}</text>
                                <color>#bfbfbf</color>
                                <margins>
                                    <left>8</left>
                                </margins>
                            </label>
                        </children>
                        <sizing>
                            <horizontal method="fixed">208</horizontal>
                            <vertical method="fixed">38</vertical>
                        </sizing>
                        <vertical-alignment>center</vertical-alignment>
                        <padding>
                            <left>8</left>
                        </padding>
                        <gap>2</gap>
                    </flow-layout>

                    <button id="{{configId}}">
                        <sizing>
                            <horizontal method="fixed">26</horizontal>
                            <vertical method="fixed">13</vertical>
                        </sizing>
                    </button>
                </children>
                <sizing>
                    <horizontal method="fixed">248</horizontal>
                    <vertical method="fixed">45</vertical>
                </sizing>
                <vertical-alignment>center</vertical-alignment>
            </flow-layout>
        </template>

        <template name="entry-field">
            <flow-layout direction="horizontal">
                <children>
                    <flow-layout direction="vertical">
                        <children>
                            <label>
                                <text>{{title}}</text>
                                <color>#e66aff</color>
                                <margins>
                                    <top>1</top>
                                    <left>4</left>
                                </margins>
                            </label>
                            <label>
                                <text>{{desc}}</text>
                                <color>#bfbfbf</color>
                                <margins>
                                    <left>8</left>
                                </margins>
                            </label>
                        </children>
                        <sizing>
                            <horizontal method="fixed">181</horizontal>
                            <vertical method="fixed">38</vertical>
                        </sizing>
                        <vertical-alignment>center</vertical-alignment>
                        <padding>
                            <left>8</left>
                        </padding>
                        <gap>2</gap>
                    </flow-layout>

                    <stack-layout>
                        <children>
                            <flow-layout direction="horizontal" id="{{configId}}">
                                <children/>
                                <sizing>
                                    <horizontal method="fixed">53</horizontal>
                                    <vertical method="fixed">19</vertical>
                                </sizing>
                            </flow-layout>

                            <text-box id="{{configId}}">
                                <sizing>
                                    <horizontal method="fixed">44</horizontal>
                                    <vertical method="fixed">10</vertical>
                                </sizing>
                                <show-background>false</show-background>
                                <margins>
                                    <top>3</top>
                                    <left>3</left>
                                    <right>2</right>
                                </margins>
                            </text-box>
                        </children>
                        <sizing>
                            <vertical method="fixed">38</vertical>
                            <horizontal method="fixed">53</horizontal>
                        </sizing>
                        <vertical-alignment>center</vertical-alignment>
                    </stack-layout>
                </children>
                <sizing>
                    <horizontal method="fixed">248</horizontal>
                    <vertical method="fixed">45</vertical>
                </sizing>
                <vertical-alignment>center</vertical-alignment>
            </flow-layout>
        </template>
    </templates>

</owo-ui>