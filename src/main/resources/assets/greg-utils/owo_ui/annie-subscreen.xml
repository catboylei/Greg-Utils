<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">

    <components>
        <stack-layout id="root">
            <children>
                <flow-layout direction="vertical" id="window">

                    <children>
                        <flow-layout direction="vertical" id="bg">
                            <children>
                                <flow-layout direction="horizontal" id="top-bar">
                                    <children>
                                        <label id="top-bar-label">
                                            <sizing>
                                                <vertical method="fixed">15</vertical>
                                                <horizontal method="content">0</horizontal>
                                            </sizing>
                                            <!--horizontal-text-alignment>center</horizontal-text-alignment-->
                                            <vertical-text-alignment>center</vertical-text-alignment>
                                            <text>FKL Annies :3</text>
                                            <color>#ffffff</color>
                                            <margins><top>2</top></margins>
                                        </label>

                                        <button id="back">
                                            <sizing>
                                                <vertical method="fixed">10</vertical>
                                                <horizontal method="fixed">10</horizontal>
                                            </sizing>

                                            <positioning type="relative">99,50</positioning>
                                        </button>

                                        <button id="discord">
                                            <sizing>
                                                <vertical method="fixed">10</vertical>
                                                <horizontal method="fixed">13</horizontal>
                                            </sizing>

                                            <positioning type="relative">1,50</positioning>
                                        </button>
                                    </children>

                                    <margins><top>4</top></margins>
                                    <sizing>
                                        <vertical method="fixed">15</vertical>
                                        <horizontal method="fixed">318</horizontal>
                                    </sizing>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <vertical-alignment>center</vertical-alignment>
                                </flow-layout>

                                <scroll direction="horizontal">
                                    <flow-layout direction="horizontal" id="party-holder">
                                        <children>
                                        </children>
                                        <sizing>
                                            <!--horizontal method="fill">100</horizontal-->
                                            <vertical method="fixed">168</vertical>
                                        </sizing>
                                        <gap>4</gap>
                                        <padding>
                                            <all>4</all>
                                        </padding>
                                        <horizontal-alignment>center</horizontal-alignment>
                                    </flow-layout>
                                    <sizing>
                                        <horizontal method="fixed">326</horizontal>
                                        <vertical method="fixed">168</vertical>
                                    </sizing>
                                    <scrollbar-thiccness>0</scrollbar-thiccness>
                                    <horizontal-alignment>left</horizontal-alignment>
                                </scroll>
                            </children>

                            <sizing>
                                <horizontal method="fill">100</horizontal> <!-- 334 x 195 -->
                                <vertical method="fill">100</vertical>
                            </sizing>

                            <horizontal-alignment>center</horizontal-alignment>
                            <margins>
                                <all>4</all>
                            </margins>

                        </flow-layout>
                    </children>

                    <sizing>
                        <!-- roughly 2x and 1.1x the sizes of the survival inventory -->
                        <horizontal method="fixed">334</horizontal>
                        <vertical method="fixed">195</vertical>
                    </sizing>
                    <allow-overflow>true</allow-overflow>
                    <surface>
                        <panel></panel>
                    </surface>
                </flow-layout>
            </children>

            <horizontal-alignment>center</horizontal-alignment>
            <vertical-alignment>center</vertical-alignment>
        </stack-layout>
    </components>

    <templates>
        <template name="party-panel">
            <flow-layout direction="vertical" id="panel">
                <children>
                    <flow-layout direction="horizontal" id="panel-top">
                        <children>
                        </children>

                        <margins>
                            <top>3</top>
                        </margins>
                        <horizontal-alignment>center</horizontal-alignment>
                        <vertical-alignment>center</vertical-alignment>
                        <allow-overflow>true</allow-overflow>
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="fixed">17</vertical>
                        </sizing>
                    </flow-layout>

                    <flow-layout direction="vertical" id="annie-separator">
                        <children></children>
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="fixed">3</vertical>
                        </sizing>
                        <margins>
                            <bottom>4</bottom>
                            <horizontal>1</horizontal>
                        </margins>
                    </flow-layout>
                </children>

                <sizing>
                    <horizontal method="fixed">103</horizontal>
                    <vertical method="fixed">160</vertical>
                </sizing>

                <surface>
                    <panel dark="true"/>
                </surface>
                <horizontal-alignment>center</horizontal-alignment>
                <vertical-alignment>top</vertical-alignment>
            </flow-layout>
        </template>
    </templates>
</owo-ui>