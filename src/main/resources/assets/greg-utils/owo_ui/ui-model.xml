<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <stack-layout id="root">
            <children>
                <flow-layout direction="horizontal" id="window">
                    <children>
                        <flow-layout direction="vertical" id="window-left">
                            <children>
                                <button id="category-general">
                                    <sizing>
                                        <horizontal method="fixed">50</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>General</text>
                                </button>

                                <button id="category-holes">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Holes</text>
                                </button>

                                <button id="category-hold">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Hold</text>
                                </button>

                                <button id="category-tree">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Tree</text>
                                </button>

                                <button id="category-light">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Light</text>
                                </button>

                                <button id="category-bulb">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Bulb</text>
                                </button>

                                <button id="category-gather">
                                    <sizing>
                                        <horizontal method="fixed">40</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Gather</text>
                                </button>

                                <button id="category-greg">
                                    <sizing>
                                        <horizontal method="fixed">50</horizontal>
                                        <vertical method="fixed">15</vertical>
                                    </sizing>
                                    <text>Gregory</text>
                                </button>
                            </children>
                            <vertical-alignment>center</vertical-alignment>
                            <horizontal-alignment>center</horizontal-alignment>
                            <sizing>
                                <horizontal method="fixed">62</horizontal>
                                <vertical method="fixed">195</vertical>
                            </sizing>
                            <padding>
                                <left>4</left>
                            </padding>
                            <gap>6</gap>
                        </flow-layout>

                        <flow-layout direction="horizontal" id="separator">
                            <children></children>
                            <sizing>
                                <horizontal method="fixed">6</horizontal>
                                <vertical method="fixed">195</vertical>
                            </sizing>
                        </flow-layout>
                    </children>

                    <sizing>
                        <!-- roughly 2x and 1.1x the sizes of the survival inventory -->
                        <horizontal method="fixed">334</horizontal>
                        <vertical method="fixed">195</vertical>
                    </sizing>
                    <allow-overflow>true</allow-overflow>
                </flow-layout>
            </children>

            <horizontal-alignment>center</horizontal-alignment>
            <vertical-alignment>center</vertical-alignment>
        </stack-layout>
    </components>

</owo-ui>